{
  "openapi": "3.1.0",
  "info": {
    "title": "Local Database QA — HTTP API",
    "version": "2 (v2 answers) / 3 (v3 library)",
    "description": "Fully local, authenticated API. All v3 responses redact server paths."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          }
        },
        "additionalProperties": true,
        "required": [
          "error",
          "status"
        ]
      },
      "Bootstrap": {
        "type": "object",
        "properties": {
          "pairing_code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "lan_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true,
        "required": [
          "pairing_code",
          "lan_urls"
        ]
      },
      "PairRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "additionalProperties": true,
        "required": [
          "code"
        ]
      },
      "PairResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          },
          "expires_in": {
            "type": "integer"
          }
        },
        "additionalProperties": true,
        "required": [
          "token",
          "expires_in"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "api_version": {
            "type": "integer"
          },
          "queue_depth": {
            "type": "integer"
          },
          "lan_urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "documents": {
            "type": "integer"
          },
          "chunks": {
            "type": "integer"
          }
        },
        "additionalProperties": true,
        "required": [
          "service",
          "api_version",
          "queue_depth",
          "lan_urls"
        ]
      },
      "CreateJobRequest": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "scope": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "additionalProperties": true,
        "required": [
          "question"
        ]
      },
      "JobCreated": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true,
        "required": [
          "job_id",
          "status"
        ]
      },
      "JobCancelled": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "const": "cancelling"
          }
        },
        "additionalProperties": true,
        "required": [
          "job_id",
          "status"
        ]
      },
      "StatusResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true,
        "required": [
          "status"
        ]
      },
      "NDJSONEvent": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string"
          }
        },
        "additionalProperties": true,
        "required": [
          "event"
        ]
      },
      "JobStatus": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          },
          "created_at": {
            "type": "number"
          },
          "event_count": {
            "type": "integer"
          },
          "cancelled": {
            "type": "boolean"
          },
          "timed_out": {
            "type": "boolean"
          }
        },
        "additionalProperties": true,
        "required": [
          "job_id",
          "status",
          "done"
        ]
      },
      "LibraryOverview": {
        "type": "object",
        "properties": {
          "statistics": {
            "type": "object"
          },
          "knowledge_bases": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": true,
        "required": [
          "statistics",
          "knowledge_bases",
          "documents"
        ]
      },
      "KnowledgeBaseList": {
        "type": "object",
        "properties": {
          "knowledge_bases": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": true,
        "required": [
          "knowledge_bases"
        ]
      },
      "KnowledgeBase": {
        "type": "object",
        "properties": {
          "knowledge_base_id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "TagList": {
        "type": "object",
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true,
        "required": [
          "tags"
        ]
      },
      "DocumentList": {
        "type": "object",
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "additionalProperties": true,
        "required": [
          "documents"
        ]
      },
      "ImportRequest": {
        "type": "object",
        "properties": {
          "action": {
            "const": "import"
          },
          "path": {
            "type": "string"
          },
          "knowledge_base_id": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "force": {
            "type": "boolean"
          },
          "dry_run": {
            "type": "boolean"
          }
        },
        "additionalProperties": true,
        "required": [
          "action",
          "path"
        ]
      },
      "ImportResult": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "DocumentAction": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "TagUpdate": {
        "type": "object",
        "properties": {
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true,
        "required": [
          "tags"
        ]
      }
    }
  },
