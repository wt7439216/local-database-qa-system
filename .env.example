QA_OLLAMA_URL=http://localhost:11434
QA_ANSWER_MODEL=qwen2.5:7b
# 中文检索推荐 bge-m3；nomic-embed-text 为兼容默认值
QA_EMBEDDING_MODEL=nomic-embed-text
QA_ANSWER_CONTEXT_WINDOW=8192
QA_ANSWER_NUM_PREDICT=800
QA_DESKTOP_HOST=127.0.0.1
QA_DESKTOP_PORT=8765
# QA_PAIRING_CODE=123456
# QA_LOG_FILE=qa.log
# 每次回答追加一行 JSONL 到 data/logs/qa_log.jsonl（设为 0 关闭）
# QA_TELEMETRY=0

# --- v3.0 向量后端（默认 sqlite，行为与 v2 完全一致）---
# VECTOR_BACKEND=sqlite
# VECTOR_BACKEND=qdrant
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION=local_knowledge_chunks
# QDRANT_TIMEOUT_SECONDS=10
# 选择 qdrant 时需先建索引：
#   python -X utf8 scripts/rebuild_vector_index.py
#   python -X utf8 scripts/verify_vector_index.py

# --- v3.1 Reranker（默认关闭；关闭时与 Phase A 行为完全一致）---
# Reranker 运行在独立 sidecar 进程（reranker_service/，自带可选依赖环境）：
#   cd reranker_service && .venv\Scripts\python server.py --device auto
# RERANKER_ENABLED=false
# RERANKER_URL=http://127.0.0.1:7998
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_CANDIDATE_K=16
# RERANK_TIMEOUT_SECONDS=30
# RERANKER_FALLBACK=disabled   # disabled=显式报错；rrf=回退 RRF 排序

# Phase D security closure: directories (os.pathsep separated, ";" on Windows)
# that WEB path-based imports/relinks are confined to. Empty = web path import
# disabled. CLI imports (import_document.py) always keep local-user permissions.
# LIBRARY_IMPORT_ROOTS=D:\Knowledge;E:\Docs
