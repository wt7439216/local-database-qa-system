* text=auto

*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf

*.pdf binary
*.sqlite3 binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary

# Frozen evidence carries raw-byte SHA commitments. Keep these bytes exact;
# ordinary source files above still use canonical line endings on checkout.
eval/*.json -text
tests/fixtures/**/*.json -text
PUBLICATION_EVIDENCE.json -text
